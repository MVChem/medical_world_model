# Shared rules; project-specific paths belong in each project's .gitignore.
# Keep third-party source, paper assets, literature, and curated results trackable.

# PDFs stay local; keep figure sources and images in 27cvpr/ppt/.
*.[pP][dD][fF]

# Local settings and editor files
.env
.env.*
!.env.example
!.env.template
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~
*.bak
*.tmp
*.pid
/experiments/.registry.lock

# Environments, installed metadata, and build artifacts
.venv
venv/
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
*.dist-info/
*.egg
build/
dist/

# Tool caches and test reports
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Run directories and logs (also match symlinks)
runs
*_runs
logs
*_logs
wandb
tensorboard
events.out.tfevents.*
*.log
*.log.*

# Local data/model stores; do not blanket-ignore source packages named data/datasets
/data
/datasets
/weights
/checkpoints
/code/*/checkpoints
/code/*/weights
/code/*/outputs

# Model binaries, tensor dumps, and dataset files within code/
/code/**/*.pt
/code/**/*.pth
/code/**/*.ckpt
/code/**/*.safetensors
/code/**/*.th
/code/**/*.onnx
/code/**/pytorch_model*.bin
/code/**/optimizer*.bin
/code/**/training_args.bin
/code/**/*.npy
/code/**/*.npz
/code/**/*.parquet
/code/**/*.arrow
/code/**/*.h5
/code/**/*.hdf5
/code/**/*.nii
/code/**/*.nii.gz
/code/**/*.dcm
